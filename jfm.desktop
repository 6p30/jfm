[Desktop Entry]
Type=Application
Version=1.0
Name=jfm
GenericName=File Manager
Comment=Manage files
Exec=jfm %U
Icon=jfm
Terminal=false
StartupNotify=true
Categories=System;FileManager;Filesystem;Utility;Core;
MimeType=inode/directory;
Actions=new-window;
X-JFM-Select-File=jfm --select-file

[Desktop Action new-window]
Name=New Window
Exec=jfm
